# Live counters (CmdTab download count in Projects.exe) — Upstash Redis.
# Copy to .env.local and fill in. Read ONLY by api/downloads.js on the server;
# these are never bundled into the client, so a full-access token is fine here.
# NOTE: do not add a VITE_ prefix — that would inline them into public JS.
#
# On Vercel nothing needs setting by hand: the Redis marketplace integration
# already injects KV_REST_API_URL / KV_REST_API_READ_ONLY_TOKEN, which
# api/downloads.js falls back to automatically. These UPSTASH_* names are for
# local dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# PIN-gated résumé (api/resume.js). The PDF is committed only as ciphertext in
# api/_resume.enc.js; RESUME_KEY (64 hex chars) decrypts it. To update the
# résumé: RESUME_KEY=... node scripts/encrypt-resume.js path/to/resume.pdf
RESUME_PIN=""
RESUME_KEY=""
